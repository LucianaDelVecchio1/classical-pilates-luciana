# robots.txt — example for maximum search + AI visibility
# Place at the domain root: https://example.com/robots.txt
# Edit the domain and the disallowed paths for your stack.
# Reminder: robots.txt controls CRAWLING, not indexing. To remove a page from
# results use a `noindex` meta tag / header, not a Disallow here.

# --- Default: allow everything, block only low-value / private areas ---
User-agent: *
Allow: /
Disallow: /admin/
Disallow: /cart/
Disallow: /checkout/
Disallow: /*?*sort=
Disallow: /*?*filter=
# WordPress example (uncomment if on WP):
# Disallow: /wp-admin/
# Allow: /wp-admin/admin-ajax.php

